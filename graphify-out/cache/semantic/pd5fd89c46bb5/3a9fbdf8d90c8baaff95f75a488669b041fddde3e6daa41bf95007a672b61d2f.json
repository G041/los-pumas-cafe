{"nodes": [{"id": "claude_skills_frontend_design_skill_frontend_design_skill", "label": "Frontend Design Skill", "file_type": "document", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_frontend_design_skill_hero_as_thesis", "label": "Hero as Thesis", "file_type": "rationale", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open the page with the most characteristic thing in the subject's world rather than a generic stat-and-gradient template, so the hero communicates a real thesis about the subject."}, {"id": "claude_skills_frontend_design_skill_typography_carries_personality", "label": "Typography Carries Personality", "file_type": "rationale", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pair display and body faces deliberately per-project rather than reusing default pairings, so type itself becomes a memorable part of the design instead of a neutral delivery vehicle."}, {"id": "claude_skills_frontend_design_skill_structure_is_information", "label": "Structure Is Information", "file_type": "rationale", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structural devices like numbering, eyebrows, and dividers should encode something true about the content (e.g. real sequence), not decorate it by default."}, {"id": "claude_skills_frontend_design_skill_deliberate_motion", "label": "Deliberate Motion", "file_type": "rationale", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose one orchestrated animation moment that serves the subject rather than scattering effects, since excess motion reads as AI-generated."}, {"id": "claude_skills_frontend_design_skill_match_complexity_to_vision", "label": "Match Complexity to Vision", "file_type": "rationale", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maximalist directions require elaborate execution, minimal directions require spacing/type precision; elegance is executing the chosen vision well."}, {"id": "claude_skills_frontend_design_skill_ai_generated_design_defaults", "label": "AI-Generated Design Defaults (Three Looks)", "file_type": "concept", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Names the three visual clusters AI-generated design defaults to (cream/serif/terracotta; near-black/single accent; broadsheet hairline-rule layout) so they can be recognized and avoided unless the brief calls for them."}, {"id": "claude_skills_frontend_design_skill_design_process_brainstorm_to_critique", "label": "Design Process: Brainstorm, Explore, Plan, Critique, Build, Critique Again", "file_type": "concept", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A two-pass process: draft a compact token system (color/type/layout/signature), then review it against the brief for genericness before writing code."}, {"id": "claude_skills_frontend_design_skill_restraint_and_self_critique", "label": "Restraint and Self-Critique", "file_type": "rationale", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spend boldness in one signature element, keep the rest quiet, and self-critique by removing an accessory before shipping (Chanel maxim), while still meeting a quality floor of responsiveness, focus states, and reduced-motion support."}, {"id": "claude_skills_frontend_design_skill_writing_in_design_principles", "label": "Writing in Design Principles", "file_type": "rationale", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copy is design material: name things by what users control, use active voice, keep failure/empty states directive rather than apologetic, and keep register conversational and consistent."}], "edges": [{"source": "claude_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_license_apache_license_2_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_skill_hero_as_thesis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_skill_typography_carries_personality", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_skill_structure_is_information", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claud